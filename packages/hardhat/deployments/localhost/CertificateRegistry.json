  "metadata": "{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"fileHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"enum CertificateRegistry.Status\",\"name\":\"newStatus\",\"type\":\"uint8\"}],\"name\":\"CertificateStatusChanged\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"fileHash\",\"type\":\"bytes32\"}],\"name\":\"getStatus\",\"outputs\":[{\"internalType\":\"enum CertificateRegistry.Status\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"fileHash\",\"type\":\"bytes32\"}],\"name\":\"issueCertificate\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"fileHash\",\"type\":\"bytes32\"}],\"name\":\"revokeCertificate\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"teacher\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"project/contracts/CertificateRegistry.sol\":\"CertificateRegistry\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"project/contracts/CertificateRegistry.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity ^0.8.30;\\n\\ncontract CertificateRegistry {\\n    enum Status { Unregistered, Valid, Revoked }\\n\\n    address public immutable teacher = msg.sender;\\n    mapping(bytes32 => Status) private statuses;\\n\\n    event CertificateStatusChanged(bytes32 indexed fileHash, Status newStatus);\\n\\n    modifier onlyTeacher() {\\n        require(msg.sender == teacher, \\\"Only teacher\\\");\\n        _;\\n    }\\n\\n    function issueCertificate(bytes32 fileHash) external onlyTeacher {\\n        require(fileHash != bytes32(0), \\\"Zero hash\\\");\\n        require(statuses[fileHash] == Status.Unregistered, \\\"Already registered\\\");\\n        statuses[fileHash] = Status.Valid;\\n        emit CertificateStatusChanged(fileHash, Status.Valid);\\n    }\\n\\n    function revokeCertificate(bytes32 fileHash) external onlyTeacher {\\n        require(statuses[fileHash] == Status.Valid, \\\"Certificate not valid\\\");\\n        statuses[fileHash] = Status.Revoked;\\n        emit CertificateStatusChanged(fileHash, Status.Revoked);\\n    }\\n\\n    function getStatus(bytes32 fileHash) external view returns (Status) {\\n        return statuses[fileHash];\\n    }\\n}\\n\",\"keccak256\":\"0x6a13386665d5becdf416d0f830f5d4254f2e4d9c40476abe006e1b210b4741a6\",\"license\":\"MIT\"}},\"version\":1}",
